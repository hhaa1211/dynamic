<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notchContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <!-- Primary Dynamic Island Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/notchCard"
        android:layout_width="138dp"
        android:layout_height="46dp"
        android:layout_gravity="center_horizontal"
        app:cardBackgroundColor="@color/notch_background"
        app:cardCornerRadius="23dp"
        app:cardElevation="12dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- ========================================================= -->
            <!-- 1. COMPACT PRESENTATIONS (Apple Compact Leading + Trailing) -->
            <!-- ========================================================= -->

            <!-- Compact 1: Nusa Mascot Pet (Resting state) -->
            <FrameLayout
                android:id="@+id/compactPet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_pet_ambient" />

                <LinearLayout
                    android:id="@+id/eyesContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/leftEye"
                        android:layout_width="10dp"
                        android:layout_height="15dp"
                        android:background="@drawable/bg_notch_pill"
                        android:backgroundTint="#FFFFFF" />

                    <!-- Clear space for Redmi Note 13 Pro 5G punch hole camera -->
                    <View
                        android:id="@+id/cameraSpace"
                        android:layout_width="72dp"
                        android:layout_height="14dp" />

                    <View
                        android:id="@+id/rightEye"
                        android:layout_width="10dp"
                        android:layout_height="15dp"
                        android:background="@drawable/bg_notch_pill"
                        android:backgroundTint="#FFFFFF" />
                </LinearLayout>
            </FrameLayout>

            <!-- Compact 2: Apple Live Activity - Music (Album art + Equalizer Waveform) -->
            <LinearLayout
                android:id="@+id/compactMusic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone">

                <!-- Leading: Album Art glyph -->
                <TextView
                    android:id="@+id/compactMusicIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_notch_pill"
                    android:backgroundTint="#19B8FF"
                    android:gravity="center"
                    android:text="🎵"
                    android:textSize="11sp" />

                <!-- Center: Clearance for camera cutout -->
                <View
                    android:id="@+id/compactMusicCutout"
                    android:layout_width="72dp"
                    android:layout_height="14dp" />

                <!-- Trailing: Real-time 4-bar Equalizer Waveform (ılılı) -->
                <LinearLayout
                    android:id="@+id/compactMusicEq"
                    android:layout_width="22dp"
                    android:layout_height="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/eqBar1"
                        android:layout_width="2.5dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_eq_bar" />

                    <View
                        android:id="@+id/eqBar2"
                        android:layout_width="2.5dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_eq_bar" />

                    <View
                        android:id="@+id/eqBar3"
                        android:layout_width="2.5dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_eq_bar" />

                    <View
                        android:id="@+id/eqBar4"
                        android:layout_width="2.5dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_eq_bar" />
                </LinearLayout>
            </LinearLayout>

            <!-- Compact 3: Apple Live Activity - Pomodoro Timer (Timer glyph + Countdown) -->
            <LinearLayout
                android:id="@+id/compactPomo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:gravity="center"
                    android:text="⏱️"
                    android:textSize="13sp" />

                <View
                    android:id="@+id/compactPomoCutout"
                    android:layout_width="72dp"
                    android:layout_height="14dp" />

                <TextView
                    android:id="@+id/tvCompactPomoTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24:50"
                    android:textColor="#FF9F0A"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Compact 4: Apple Battery Charging HUD (Bolt + Percent) -->
            <LinearLayout
                android:id="@+id/compactCharging"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡"
                    android:textColor="@color/green_charging"
                    android:textSize="14sp" />

                <View
                    android:id="@+id/compactChargeCutout"
                    android:layout_width="72dp"
                    android:layout_height="14dp" />

                <TextView
                    android:id="@+id/tvCompactChargePercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="92%"
                    android:textColor="@color/green_charging"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Compact 5: Apple Call Activity (Phone glyph + Timer) -->
            <LinearLayout
                android:id="@+id/compactCall"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📞"
                    android:textColor="#34C759"
                    android:textSize="13sp" />

                <View
                    android:id="@+id/compactCallCutout"
                    android:layout_width="72dp"
                    android:layout_height="14dp" />

                <TextView
                    android:id="@+id/tvCompactCallTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01:24"
                    android:textColor="#34C759"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>


            <!-- ========================================================= -->
            <!-- 2. EXPANDED PRESENTATIONS (Apple Expanded Contextual Card) -->
            <!-- ========================================================= -->

            <!-- Expanded 1: Music Player -->
            <LinearLayout
                android:id="@+id/layerMusic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="38dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <!-- Audio Output Route Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvOutputRoute"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_route_pill"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="🎧 Redmi Note 13 Pro • Loa ngoài"
                        android:textColor="@color/cyan_accent"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btnCloseMusic"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="✕"
                        android:textColor="@color/mist_gray"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Track info row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMusicArt"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_pet_ambient"
                        android:gravity="center"
                        android:text="🎵"
                        android:textSize="22sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvMusicTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Paper Sky"
                            android:textColor="@color/ink_white"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvMusicArtist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Lumen Coast"
                            android:textColor="@color/mist_gray"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Scrubber / Timeline row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTimeCurrent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1:14"
                        android:textColor="@color/mist_gray"
                        android:textSize="10sp" />

                    <ProgressBar
                        android:id="@+id/musicProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="45"
                        android:progressTint="@color/cyan_accent" />

                    <TextView
                        android:id="@+id/tvTimeRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-2:46"
                        android:textColor="@color/mist_gray"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Apple Playback Controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnShuffle"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="🔀"
                        android:textColor="@color/mist_gray"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnPrev"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="14dp"
                        android:gravity="center"
                        android:text="⏮"
                        android:textColor="@color/ink_white"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/btnPlayPause"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_notch_pill"
                        android:backgroundTint="#FFFFFF"
                        android:gravity="center"
                        android:text="⏸"
                        android:textColor="#000000"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/btnNext"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="14dp"
                        android:gravity="center"
                        android:text="⏭"
                        android:textColor="@color/ink_white"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/btnRepeat"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="🔁"
                        android:textColor="@color/mist_gray"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Expanded 2: Pomodoro Focus Timer -->
            <LinearLayout
                android:id="@+id/layerPomo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="38dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_route_pill"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="⏱️ POMODORO • HIỆP 2/4"
                        android:textColor="#FF9F0A"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btnClosePomo"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="✕"
                        android:textColor="@color/mist_gray"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPomoCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24:50"
                        android:textColor="@color/ink_white"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thời gian tập trung sâu"
                        android:textColor="#FF9F0A"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPomoToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="#FF9F0A"
                        android:text="Tạm dừng"
                        android:textColor="#000000"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnPomoReset"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="12dp"
                        android:backgroundTint="#26FFFFFF"
                        android:text="Đặt lại"
                        android:textColor="@color/ink_white"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Expanded 3: 67W Turbo Charging -->
            <LinearLayout
                android:id="@+id/layerCharging"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="38dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_route_pill"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="⚡ 67W TURBO CHARGE"
                        android:textColor="@color/green_charging"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btnCloseCharge"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="✕"
                        android:textColor="@color/mist_gray"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvChargePercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ 92%"
                        android:textColor="@color/green_charging"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sạc siêu nhanh • Đầy trong 18 phút"
                        android:textColor="@color/mist_gray"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Expanded 4: Apple Incoming Call Alert -->
            <LinearLayout
                android:id="@+id/layerCall"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="38dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_route_pill"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="📞 CUỘC GỌI ĐẾN"
                        android:textColor="#34C759"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btnCloseCall"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="✕"
                        android:textColor="@color/mist_gray"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_pet_ambient"
                        android:gravity="center"
                        android:text="👤"
                        android:textSize="22sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nguyễn Văn A"
                            android:textColor="@color/ink_white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Di động • 0987.654.321"
                            android:textColor="@color/mist_gray"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Call Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnDeclineCall"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_call_decline"
                        android:gravity="center"
                        android:text="📵"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/btnAcceptCall"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="36dp"
                        android:background="@drawable/bg_call_accept"
                        android:gravity="center"
                        android:text="📞"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>

        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Secondary Detached Bubble (Apple Minimal Presentation) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/detachedBubble"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:translationX="114dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/notch_background"
        app:cardCornerRadius="22dp"
        app:cardElevation="12dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvBubbleIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⏱️"
                android:textSize="16sp" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
